.DS_Store
.env
.env.*
!.env.example
node_modules/
**/node_modules/
*.db
*.db-shm
*.db-wal
**/backups/
coverage/
dist/
target/
.turbo/

# Repo-local agent skills are checked in. A global ignore may exclude .claude/
# wholesale; re-include only the skills tree, keeping local settings untracked.
!.claude/
.claude/*
!.claude/skills/
!.claude/memory/
