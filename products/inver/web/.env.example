# Base URL of the inference gateway. The web app is the only caller of /internal.
GATEWAY_URL=http://127.0.0.1:8080

# Public /v1 base URL shown in landing-page setup examples.
NEXT_PUBLIC_GATEWAY_URL=https://gateway.inver.example/v1

# The gateway ADMIN_API_KEY. Server-side only; never exposed to the browser.
GATEWAY_ADMIN_KEY=

# The gateway WEB_BFF_API_KEY. Restricted to registration and customer self-service routes.
GATEWAY_WEB_KEY=

# Password for the operator console at /admin. Required for admin sign-in.
ADMIN_CONSOLE_PASSWORD=

# 32+ random bytes, base64. Signs customer and operator session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
