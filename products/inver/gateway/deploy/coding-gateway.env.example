HOST=127.0.0.1
PORT=8080
DATABASE_PATH=/var/lib/tundral/inference-gateway/gateway.db
ADMIN_API_KEY=replace-with-a-long-random-secret
WEB_BFF_API_KEY=replace-with-a-different-long-random-secret
REQUIRE_SCOPED_INTERNAL_KEYS=true
METRICS_API_KEY=replace-with-a-third-long-random-secret
# Selects the adapter only while UPSTREAM_CONFIG_SOURCE=environment. Database routes may mix both.
UPSTREAM_MODE=codex-cli
UPSTREAM_CONFIG_SOURCE=environment
# Required for database-managed upstreams. Back it up separately from the database.
UPSTREAM_CREDENTIAL_ENCRYPTION_KEY=
ALLOW_INSECURE_UPSTREAM_HTTP=false
ALLOW_PRIVATE_UPSTREAM_NETWORKS=false
# To use an OpenAI-compatible provider pool, switch UPSTREAM_MODE to openai and configure
# OPENAI_UPSTREAMS_JSON as documented in the application README. UPSTREAM_API_KEY and
# UPSTREAM_BASE_URL remain supported for a single provider.
OPENAI_UPSTREAMS_JSON=
UPSTREAM_MAX_CONCURRENCY_PER_PROVIDER=4
UPSTREAM_MAX_ATTEMPTS=3
UPSTREAM_FAILURE_COOLDOWN_MS=30000
UPSTREAM_REQUEST_TIMEOUT_MS=120000
CODEX_EXECUTABLE=/usr/local/bin/codex
CODEX_WORKDIR=/opt/tundral/apps/inference-gateway
DEFAULT_MAX_OUTPUT_TOKENS=4096
MAX_OUTPUT_TOKENS_PER_REQUEST=16384
MAX_CONCURRENT_REQUESTS_PER_KEY=2
REQUESTS_PER_MINUTE_PER_KEY=60
MAX_GLOBAL_CONCURRENT_REQUESTS=4
RESERVATION_TTL_MS=600000
IDEMPOTENCY_IN_PROGRESS_TTL_MS=900000
RECOVERY_INTERVAL_MS=60000
GENERATION_ENABLED=true
