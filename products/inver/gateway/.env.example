PORT=8080
HOST=127.0.0.1
DATABASE_PATH=./gateway.db
UPSTREAM_CONFIG_SOURCE=environment
# Required when UPSTREAM_CONFIG_SOURCE=database and for credential creation/rotation APIs.
# Generate once with: openssl rand -base64 32
UPSTREAM_CREDENTIAL_ENCRYPTION_KEY=
# Database-managed URLs require HTTPS and reject literal private-network hosts by default.
ALLOW_INSECURE_UPSTREAM_HTTP=false
ALLOW_PRIVATE_UPSTREAM_NETWORKS=false
UPSTREAM_BASE_URL=https://api.openai.com
UPSTREAM_API_KEY=
# For a multi-provider OpenAI-compatible pool, set OPENAI_UPSTREAMS_JSON instead of the two legacy
# variables above. Prefer api_key_env so credentials are not duplicated inside the JSON.
# OPENAI_VENDOR_A_KEY=
# OPENAI_VENDOR_B_KEY=
# OPENAI_UPSTREAMS_JSON=[{"id":"vendor-a-1","base_url":"https://vendor-a.example/v1","api_key_env":"OPENAI_VENDOR_A_KEY","weight":2,"max_concurrency":2},{"id":"vendor-b-1","base_url":"https://vendor-b.example","api_key_env":"OPENAI_VENDOR_B_KEY","weight":1,"max_concurrency":4,"models":["gpt-5.5"]}]
UPSTREAM_MAX_CONCURRENCY_PER_PROVIDER=4
UPSTREAM_MAX_ATTEMPTS=3
UPSTREAM_FAILURE_COOLDOWN_MS=30000
UPSTREAM_REQUEST_TIMEOUT_MS=120000
# In environment mode, use codex-cli for the locally authenticated ChatGPT/Codex account.
# In database mode, UPSTREAM_MODE is ignored: published routes may mix HTTP and Codex providers.
UPSTREAM_MODE=openai
CODEX_EXECUTABLE=codex
CODEX_WORKDIR=.
CODEX_TOOL_SCHEMA_PATH=./src/tool-output-schema.json
CODEX_RESERVATION_OVERHEAD_TOKENS=50000
STREAM_HEARTBEAT_MS=5000
ADMIN_API_KEY=replace-me
# Restricted credential for the web BFF's registration, customer console, and key-management calls.
# Use a different value from ADMIN_API_KEY in production.
WEB_BFF_API_KEY=replace-with-a-different-secret
REQUIRE_SCOPED_INTERNAL_KEYS=false
# Enables authenticated loopback scraping of GET /metrics. Caddy blocks this route publicly.
METRICS_API_KEY=
USDC_CHAIN=base
USDC_RECEIVING_ADDRESS=
DEFAULT_MAX_OUTPUT_TOKENS=4096
MAX_OUTPUT_TOKENS_PER_REQUEST=16384
MAX_CONCURRENT_REQUESTS_PER_KEY=2
REQUESTS_PER_MINUTE_PER_KEY=60
MAX_GLOBAL_CONCURRENT_REQUESTS=4
RESERVATION_TTL_MS=600000
IDEMPOTENCY_IN_PROGRESS_TTL_MS=900000
RECOVERY_INTERVAL_MS=60000
GENERATION_ENABLED=true
