      {
        "schema": "billing",
        "name": "open_invoices",
        "definition": " SELECT id,\n    order_id\n   FROM billing.invoices\n  WHERE (total_micros > 0);"
      },
      {
        "schema": "public",
        "name": "order_totals",
        "definition": " SELECT o.id AS order_id,\n    sum((i.quantity * p.price_micros)) AS total_micros\n   FROM ((orders o\n     JOIN order_items i ON ((i.order_id = o.id)))\n     JOIN products p ON ((p.sku = i.sku)))\n  GROUP BY o.id;"
      }
    ],
