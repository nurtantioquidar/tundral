<Window x:Class="Shop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shop"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Binding x:Key="Total" Path="Order.Total" Converter="{StaticResource MoneyConverter}" />
    </Window.Resources>
    <StackPanel x:Name="RootPanel">
        <TextBox Name="SearchBox" Text="{Binding Query}" TextChanged="Search_Changed" />
        <Button x:Name="SaveButton" Content="Save" Click="Save_Click" Command="{Binding SaveCommand}" />
        <TextBlock Text="{Binding Path=Status, Converter={StaticResource UpperConverter}}" />
        <Button Click="Unnamed_Click" Tag="Helper" />
    </StackPanel>
</Window>
