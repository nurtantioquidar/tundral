{$GATEWAY_DOMAIN} {
	encode zstd gzip

	@private path /internal/* /metrics
	respond @private 404

	request_body {
		max_size 10MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy 127.0.0.1:8080 {
		health_uri /ready
		health_interval 30s
	}
}
